<Slide style={{ backgroundColor: '#FFFFFF', padding: 60 }}>
  <Box style={{ width: 1160, height: 600, flexDirection: 'column' }}>

    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
      <Text style={{ fontSize: 14, letterSpacing: 2, color: '#2563EB' }}>01 / 三个角色</Text>
      <Box style={{ flex: 1, height: 1, backgroundColor: '#E2E8F0' }} />
    </Box>

    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.25, marginTop: 16 }}>
      一条 SQL 进来，三个角色各管一段
    </Text>

    <Box style={{ width: 1160, height: 400, marginTop: 22 }}>
      <svg width={1160} height={400} viewBox='0 0 1160 400'>
        <rect x='0' y='150' width='150' height='100' rx='12' fill='#F1F5F9' stroke='#CBD5E1' strokeWidth='1' />
        <text x='75' y='192' textAnchor='middle' fontSize='20' fontWeight='bold' fill='#0F172A'>应用</text>
        <text x='75' y='218' textAnchor='middle' fontSize='14' fill='#64748B'>客户端</text>

        <line x1='150' y1='200' x2='242' y2='200' stroke='#94A3B8' strokeWidth='2' />
        <path d='M242 195 L250 200 L242 205' fill='none' stroke='#94A3B8' strokeWidth='2' />
        <text x='196' y='188' textAnchor='middle' fontSize='14' fill='#64748B'>SQL</text>

        <rect x='250' y='150' width='250' height='100' rx='12' fill='#EFF6FF' stroke='#BFDBFE' strokeWidth='1' />
        <text x='375' y='190' textAnchor='middle' fontSize='21' fontWeight='bold' fill='#1E40AF'>CN 协调节点</text>
        <text x='375' y='218' textAnchor='middle' fontSize='15' fill='#3B82F6'>解析 · 规划 · 汇总</text>

        <rect x='250' y='10' width='250' height='96' rx='12' fill='#FFF7ED' stroke='#FDBA74' strokeWidth='1' />
        <text x='375' y='46' textAnchor='middle' fontSize='21' fontWeight='bold' fill='#B45309'>GTM 全局事务管理器</text>
        <text x='375' y='76' textAnchor='middle' fontSize='15' fill='#C2410C'>发号 · 快照 · 序列</text>

        <line x1='375' y1='150' x2='375' y2='114' stroke='#C2410C' strokeWidth='2' />
        <path d='M370 114 L375 106 L380 114' fill='none' stroke='#C2410C' strokeWidth='2' />
        <path d='M370 142 L375 150 L380 142' fill='none' stroke='#C2410C' strokeWidth='2' />
        <text x='390' y='134' fontSize='14' fill='#B45309'>GXID + 快照</text>

        <line x1='500' y1='200' x2='560' y2='200' stroke='#94A3B8' strokeWidth='2' />
        <line x1='560' y1='75' x2='560' y2='315' stroke='#94A3B8' strokeWidth='2' />
        <line x1='560' y1='75' x2='592' y2='75' stroke='#94A3B8' strokeWidth='2' />
        <path d='M592 70 L600 75 L592 80' fill='none' stroke='#94A3B8' strokeWidth='2' />
        <line x1='560' y1='195' x2='592' y2='195' stroke='#94A3B8' strokeWidth='2' />
        <path d='M592 190 L600 195 L592 200' fill='none' stroke='#94A3B8' strokeWidth='2' />
        <line x1='560' y1='315' x2='592' y2='315' stroke='#94A3B8' strokeWidth='2' />
        <path d='M592 310 L600 315 L592 320' fill='none' stroke='#94A3B8' strokeWidth='2' />

        <text x='555' y='258' textAnchor='end' fontSize='14' fill='#64748B'>带同一份快照，下发分片</text>

        <rect x='600' y='30' width='320' height='90' rx='12' fill='#FFFFFF' stroke='#CBD5E1' strokeWidth='1' />
        <text x='624' y='68' fontSize='18' fontWeight='bold' fill='#0F172A'>DN1 · 数据节点</text>
        <text x='624' y='94' fontSize='14' fill='#64748B'>分片 1 ｜ 数据真正待的地方</text>

        <rect x='600' y='150' width='320' height='90' rx='12' fill='#FFFFFF' stroke='#CBD5E1' strokeWidth='1' />
        <text x='624' y='188' fontSize='18' fontWeight='bold' fill='#0F172A'>DN2 · 数据节点</text>
        <text x='624' y='214' fontSize='14' fill='#64748B'>分片 2 ｜ 本地事务 + WAL</text>

        <rect x='600' y='270' width='320' height='90' rx='12' fill='#FFFFFF' stroke='#CBD5E1' strokeWidth='1' />
        <text x='624' y='308' fontSize='18' fontWeight='bold' fill='#0F172A'>DN3 · 数据节点</text>
        <text x='624' y='334' fontSize='14' fill='#64748B'>分片 3 ｜ 本地事务 + WAL</text>

        <rect x='960' y='140' width='200' height='140' rx='12' fill='#FFFFFF' stroke='#E2E8F0' strokeWidth='1' strokeDasharray='5 5' />
        <text x='980' y='174' fontSize='15' fontWeight='bold' fill='#0F172A'>GTM 里没有数据</text>
        <text x='980' y='202' fontSize='14' fill='#475569'>它只回答两个问题：</text>
        <text x='980' y='228' fontSize='14' fill='#475569'>你是谁 —— GXID</text>
        <text x='980' y='254' fontSize='14' fill='#475569'>此刻谁可见 —— 快照</text>
      </svg>
    </Box>

    <Box style={{ width: 1160, height: 62, marginTop: 18, backgroundColor: '#F1F5F9', borderRadius: 12, flexDirection: 'row', alignItems: 'center', paddingLeft: 24, paddingRight: 24 }}>
      <Text style={{ fontSize: 18, color: '#334155' }}>
        数据只在 DN，元数据在 CN，<span style={{ fontWeight: 'bold', color: '#0F172A' }}>顺序在 GTM</span> —— 三者职责不重叠
      </Text>
    </Box>

  </Box>
  <Box style={{ position: 'absolute', right: 60, bottom: 24 }}>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>02 / 09</Text>
  </Box>
</Slide>
